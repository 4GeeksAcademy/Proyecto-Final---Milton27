# Copia este archivo a ".env" y ajusta los valores.

# Local por defecto: SQLite (no requiere instalar nada).
# Para Postgres local o en Render: postgresql://usuario:password@host:5432/basededatos
DATABASE_URL=sqlite:///velamar.db

# Cambia esto por una cadena aleatoria antes de desplegar.
JWT_SECRET_KEY=dev-secret-cambiame

# Déjalo vacío para trabajar en "modo simulado" sin Stripe.
# Ponlo cuando tengas tu clave secreta de test de Stripe (sk_test_...).
STRIPE_SECRET_KEY=
